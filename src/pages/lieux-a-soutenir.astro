---
import Base from "../layouts/Base.astro";
import { chargerLieux, lieuxASoutenir } from "../lib/space2";

let erreur = "";
let lieux: Awaited<ReturnType<typeof chargerLieux>>["lieux"] = [];
let exemple = false;
try {
  const r = await chargerLieux();
  lieux = lieuxASoutenir(r.lieux);
  exemple = r.exemple;
} catch (e) {
  erreur = "Les lieux ne sont pas disponibles pour le moment.";
}
---
<Base titre="Portfolio · lieux à soutenir">
  <section class="hero">
    <p class="surtitre">Portfolio</p>
    <h1>Des lieux, et ce dont ils ont besoin</h1>
    <p class="lead">Une sélection de lieux du réseau, chacun avec sa synthèse et les besoins qu'il met en avant. Le soutien peut être financier, mais aussi du mécénat de compétences ou des dons de matériel. Les fiches viennent de Space2 : quand un lieu met son profil à jour, sa fiche change ici.</p>
  </section>
  {exemple && <p class="avertissement">Données d'exemple : l'API de Space2 n'est pas encore configurée.</p>}
  {erreur && <p class="avertissement">{erreur}</p>}
  <div class="grille">
    {lieux.map((l) => (
      <article class="carte">
        <h2 style="font-size:18px;margin:0 0 4px">{l.tiers_lieu}</h2>
        <p style="margin:0 0 8px;font-size:14px;color:var(--doux)">{[l.commune, l.region].filter(Boolean).join(", ")}</p>
        {l.campagne && <p style="margin:0 0 8px">{l.campagne.texte}</p>}
        {l.campagne?.objectif && <p style="margin:0 0 8px"><span class="pastille">Objectif : {l.campagne.objectif}</span></p>}
        {l.besoins_mis_en_avant && l.besoins_mis_en_avant.length > 0 && (
          <ul style="margin:0;padding-left:18px;font-size:14px">{l.besoins_mis_en_avant.map((b) => <li>{b}</li>)}</ul>
        )}
      </article>
    ))}
  </div>
  <section class="bloc">
    <div class="rangee">
      <a class="bouton" href="/carte">Voir tous les lieux sur la carte</a>
      <a class="bouton creux" href="https://space2.streamlit.app/" rel="noopener">Présenter mon lieu avec Space2</a>
      <a class="bouton creux" href="/contact">Soutenir un lieu</a>
    </div>
  </section>
</Base>
