---
import Base from "../../layouts/Base.astro";
import { chargerCommunaute } from "../../lib/config";
import { niveauAcces } from "../../lib/acces";
import {
  dansLesPays, enListe, enPoints, resumeBref, RUBRIQUES_LIEU, syntheseInterne, trouverLieu, type Champ, type SyntheseInterne,
} from "../../lib/space2";
import { chargerContenu } from "../../lib/contenu";
import { jetonsValides } from "../../lib/ctg";
import { garderJetons, lireJetons } from "../../lib/jetons";

// Fiche d'un lieu, à niveau d'accès gradué (espaces « fiche_lieu » et « fiche_lieu_interne » de communaute.yaml) :
// visiteurs → l'essentiel en bref ; membres → toute la synthèse publique de Space2 ;
// membres actifs et plus → la synthèse interne (décision du 27/11), sauf s'ils demandent la vue publique.
let lieu = null;
try {
  lieu = await trouverLieu(Astro.params.id ?? "");
} catch (e) {
  console.error("Fiche lieu :", e);
}
// Mêmes pays que la carte (data/contenu.yaml, carte.pays).
if (lieu && !dansLesPays(lieu, chargerContenu().carte?.pays ?? ["Belgique"])) lieu = null;
if (!lieu) return new Response("Lieu introuvable", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });

const u = Astro.locals.utilisateur;
const communaute = chargerCommunaute();
const contenu = chargerContenu();
const niveau = niveauAcces(communaute, u, "fiche_lieu");
const complet = niveau === "complet" || niveau === "filtre";
const categories = enListe(lieu.categories as Champ);
const ou = [lieu.commune, lieu.region, lieu.pays].filter(Boolean).join(", ");
const lien = lieu.lien_externe && /^https?:\/\//i.test(lieu.lien_externe) ? lieu.lien_externe : null;
const photo = lieu.photo_url && /^https:\/\//i.test(lieu.photo_url) ? lieu.photo_url : null;
let lienCtg: string | null = null;
if (lieu.ctg_entity_id && /^[0-9a-f-]{36}$/i.test(lieu.ctg_entity_id)) {
  try { lienCtg = `${new URL(contenu.liens.changethegame_guilde).origin}/guilds/${lieu.ctg_entity_id}`; } catch { /* lien absent */ }
}
const contributeurs = typeof lieu.nombre_contributeurs === "number" && lieu.nombre_contributeurs > 0 ? lieu.nombre_contributeurs : null;

// Synthèse interne : seulement si le badge l'ouvre (vérifié ICI, avant tout appel), avec le jeton CTG de la personne.
const peutInterne = complet && niveauAcces(communaute, u, "fiche_lieu_interne") !== "aucun";
const vuePublique = Astro.url.searchParams.get("vue") === "publique";
let interne: SyntheseInterne | null = null;
if (peutInterne && !vuePublique) {
  const jetons = await jetonsValides(lireJetons(Astro.cookies));
  if (jetons) {
    garderJetons(Astro.cookies, jetons);
    interne = await syntheseInterne(jetons.acces, Astro.params.id ?? "");
  }
}
const resume = interne?.sections.resume ?? lieu.resume;

// Rubriques détaillées, dans l'ordre de Space2 (membres seulement), en listes à puces.
// Une rubrique absente de la synthèse interne reprend la version publique.
const source = (cle: string): Champ => interne?.sections[cle] || (lieu as unknown as Record<string, Champ>)[cle];
const rubriques = RUBRIQUES_LIEU.map(([cle, titre]) => [titre, enPoints(source(cle))] as [string, string[]])
  .filter(([, items]) => items.length > 0);
const besoins = (lieu.besoins_mis_en_avant ?? []).filter(Boolean);
---
<Base titre={lieu.tiers_lieu} description={resumeBref(lieu.resume)}>
  <p class="surtitre"><a href="/carte">Carte des lieux</a> · Fiche</p>
  <section class="hero">
    <div class="entete">
      {complet && photo && <img src={photo} alt="" class="logo" loading="lazy" referrerpolicy="no-referrer" />}
      <div>
        <h1>{lieu.tiers_lieu}</h1>
        {(ou || contributeurs) && <p class="doux">{[ou, contributeurs && `${contributeurs} contributeur${contributeurs > 1 ? "s" : ""}`].filter(Boolean).join(" · ")}</p>}
      </div>
    </div>
    {categories.length > 0 && <p>{categories.map((c) => <span class="pastille" style="margin-right:6px">{c}</span>)}</p>}
    <p class="lead">{complet ? resume : resumeBref(lieu.resume)}</p>
    {complet && (lien || lienCtg) && (
      <p class="liens">
        {lien && <a href={lien} rel="noopener">Site du lieu</a>}
        {lienCtg && <a href={lienCtg} rel="noopener">Voir sur ChangeTheGame</a>}
      </p>
    )}
  </section>

  {lieu.campagne && (
    <section class="panneau bloc">
      <p class="surtitre">Ce lieu cherche du soutien</p>
      <p>{lieu.campagne.texte}</p>
      {lieu.campagne.objectif && <p><span class="pastille">Objectif : {lieu.campagne.objectif}</span></p>}
      <div class="rangee"><a class="bouton" href="/contact">Soutenir ce lieu</a></div>
    </section>
  )}

  {complet ? (
    <>
      {peutInterne && (
        <p class={interne ? "avertissement interne" : "doux"} role="note">
          {interne
            ? <>Synthèse <strong>interne</strong> : faite de toutes les réponses du lieu, y compris confidentielles. Réservée aux membres actifs : ne pas la diffuser. <a href="?vue=publique">Voir la version publique</a></>
            : vuePublique
              ? <>Version publique. <a href="?">Voir la synthèse interne</a></>
              : "La synthèse interne de ce lieu n'est pas disponible pour l'instant : voici la version publique."}
        </p>
      )}
      {besoins.length > 0 && (
        <section class="bloc">
          <h2>Besoins mis en avant</h2>
          <ul class="simple">{besoins.map((b) => <li>{b}</li>)}</ul>
        </section>
      )}
      {rubriques.length > 0 && (
        <section class="bloc">
          <h2>Le lieu en détail</h2>
          <div class="t3">
            {rubriques.map(([titre, items]) => (
              <div class="cellule">
                <h3>{titre}</h3>
                {items.length === 1 ? <p>{items[0]}</p> : <ul class="simple">{items.map((x) => <li>{x}</li>)}</ul>}
              </div>
            ))}
          </div>
        </section>
      )}
      <section class="bloc">
        <div class="rangee">
          <a class="bouton creux" href="/carte">Retour à la carte</a>
        </div>
        {lieu.updated_at && <p class="doux" style="font-size:.85rem">Fiche Space2 mise à jour le {lieu.updated_at.slice(0, 10)}.</p>}
      </section>
    </>
  ) : (
    <section class="panneau bloc">
      <h2>En savoir plus sur ce lieu</h2>
      <p>Activités, publics, partenaires, projets et besoins détaillés du lieu sont réservés aux membres de Trois-Tiers.</p>
      <div class="rangee">
        {u ? <a class="bouton" href="/adherer">Adhérer à Trois-Tiers</a> : <a class="bouton" href={`/connexion?suite=${encodeURIComponent(Astro.url.pathname)}`}>Se connecter</a>}
        {!u && <a class="bouton creux" href="/adherer">Adhérer</a>}
        <a class="bouton creux" href="/carte">Retour à la carte</a>
      </div>
    </section>
  )}
</Base>

<style>
  .entete { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .logo { width: 140px; height: 140px; object-fit: contain; border-radius: 10px; border: 1px solid var(--trait); background: #fff; }
  .liens { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .interne { margin-top: 24px; }
</style>
