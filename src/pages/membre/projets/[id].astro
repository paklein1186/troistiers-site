---
import Base from "../../../layouts/Base.astro";
import { acteurConnecte, actionTache, messageBase } from "../../../lib/acteur";
import ListeTaches from "../../../components/ListeTaches.astro";
import FaceCtgBloc from "../../../components/FaceCtg.astro";
import {
  apercuProjet, baseConfiguree, candidater, changerEtape, deverrouillerEtape, etapes, mesDroits, NATURES,
  reglerDiffusion, reglerEnjeux, retoursProjet, reglerResume, publicationCtg, proposerPublicationCtg, enregistrerQueteCtg, adresseQueteCtg, changerNature, type FaceCtg, ROLES_CONTEXTUELS, rpc, SENSIBILITES, tachesProjet, typesContenu, validerDiffusion,
  type Droits, type Etape, type ProjetVu, type Tache, profilCtg,
} from "../../../lib/base";
import { chargerContenu } from "../../../lib/contenu";

// Fiche d'un projet : ce que la personne en voit (filtré par la base), et les actions permises
// (candidater, régler la diffusion, changer l'étape, valider la diffusion, aperçu en tant que).
const u = Astro.locals.utilisateur;
const id = Astro.params.id ?? "";
const ici = `/membre/projets/${encodeURIComponent(id)}`;
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
if (!baseConfiguree() || !/^[0-9a-f-]{36}$/i.test(id)) return Astro.redirect("/membre/projets");
const acteur = await acteurConnecte(Astro.cookies);

let message = "";
const fait = Astro.url.searchParams.get("fait");
if (Astro.request.method === "POST" && acteur) {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  const f = await Astro.request.formData();
  const action = String(f.get("action") ?? "");
  try {
    if (await actionTache(acteur, f)) return Astro.redirect(f.get("vers_artefact") === "1" ? `${ici}?fait=retour#taches` : `${ici}#taches`, 303);
    if (action === "candidater") {
      await candidater(acteur, id, String(f.get("role") ?? "membre_equipe"), String(f.get("message") ?? "").slice(0, 2000));
    } else if (action === "etape") {
      await changerEtape(acteur, id, String(f.get("vers") ?? ""), String(f.get("justification") ?? "").slice(0, 500));
    } else if (action === "deverrouiller") {
      await deverrouillerEtape(acteur, id);
    } else if (action === "diffusion") {
      await reglerDiffusion(acteur, id, {
        sensibilite: String(f.get("sensibilite") ?? "sensible"),
        titre_public: f.get("titre_public") === "on",
        phrase: String(f.get("phrase") ?? "").slice(0, 300),
        validateur: String(f.get("validateur") ?? "").slice(0, 200),
        besoins_publics: f.get("besoins_publics") === "on",
      });
    } else if (action === "resume" || action === "resume_valider" || action === "resume_retirer") {
      await reglerResume(acteur, id, String(f.get("resume") ?? "").slice(0, 600), action === "resume_valider");
      await reglerEnjeux(acteur, id, String(f.get("enjeux") ?? "").slice(0, 1200), action === "resume_valider");
    } else if (action === "nature") {
      await changerNature(acteur, id, String(f.get("nature") ?? ""));
    } else if (action === "proposer_ctg") {
      await proposerPublicationCtg(acteur, id, String(f.get("message") ?? "").slice(0, 1000));
    } else if (action === "quete_ctg" || action === "retirer_ctg") {
      await enregistrerQueteCtg(acteur, id, action === "retirer_ctg" ? "" : String(f.get("adresse") ?? "").trim().slice(0, 500));
    } else if (action === "valider" || action === "refuser") {
      await validerDiffusion(acteur, id, action === "valider");
    }
    return Astro.redirect(`${ici}?fait=${encodeURIComponent(action)}`, 303);
  } catch (e) {
    console.error(`Base Trois-Tiers (${action}) :`, e);
    message = (e as { code?: string })?.code === "23514" && (e as Error).message ? `Refusé : ${(e as Error).message}` : messageBase(e);
  }
}

let p: ProjetVu | null = null;
let droits: Droits | null = null;
let listeEtapes: Etape[] = [];
let libellesTypes: Record<string, string> = {};
let apercu: ProjetVu | null = null;
let taches: Tache[] = [];
let publication: FaceCtg | null = null;
// Copie du Pilote : retours vers l'artefact (étape 4 de la décision D).
let retours: Awaited<ReturnType<typeof retoursProjet>> | null = null;
const niveauApercu = Astro.url.searchParams.get("en_tant_que");
try {
  [p, droits, listeEtapes, libellesTypes] = await Promise.all([
    apercuProjet(id, acteur),
    acteur ? mesDroits(id, acteur) : Promise.resolve(null),
    etapes().then((l) => l.sort((a, b) => a.ordre - b.ordre)),
    typesContenu().then((l) => Object.fromEntries(l.map((t) => [t.code, t.libelle]))),
  ]);
  if (droits && droits.niveau >= 4 && acteur) {
    [taches, publication, retours] = await Promise.all([
      tachesProjet(id, acteur), publicationCtg(id, acteur).catch(() => null), retoursProjet(id, acteur).catch(() => null),
    ]);
  }
  // Aperçu en tant que : réservé à l'équipe du projet et à la coordination, jamais au-dessus de son niveau.
  const n = Number(niveauApercu);
  if (droits && droits.niveau >= 4 && niveauApercu !== null && Number.isInteger(n) && n >= 0 && n <= droits.niveau) {
    apercu = await rpc<ProjetVu | null>("vue_projet", { p_projet: id, p_niveau: n });
  }
} catch (e) {
  console.error("Base Trois-Tiers (fiche) :", e);
  message ||= "Le projet n'a pas pu être chargé.";
}
if (!p && !message) return Astro.redirect("/membre/projets");
const libEtape = (c: string | null) => (c ? listeEtapes.find((e) => e.code === c)?.libelle ?? c : null);
const FAITS: Record<string, string> = {
  retour: "Envoyé à l'artefact : appliqué ici au prochain import du Pilote.",
  candidater: "Candidature envoyée : l'équipe du projet va l'examiner.",
  statut: "Statut enregistré.",
  etape: "Étape changée. Elle est verrouillée : les agents ne feront plus que proposer.",
  deverrouiller: "Étape déverrouillée.",
  diffusion: "Diffusion réglée.",
  valider: "Diffusion hors équipe validée.",
  resume: "Résumé et enjeux enregistrés comme brouillons : ils ne s'affichent pas encore hors de l'équipe.",
  resume_valider: "Résumé et enjeux validés : le résumé s'affiche là où le titre est visible, les enjeux là où les besoins le sont.",
  resume_retirer: "Validation retirée : résumé et enjeux ne s'affichent plus hors de l'équipe.",
  nature: "Nature du projet changée.",
  proposer_ctg: "Publication proposée : elle attend la validation de la coordination (file de revue).",
  quete_ctg: "Lien vers la quête enregistré : le projet est relié à ChangeTheGame.",
  retirer_ctg: "Lien vers la quête retiré.",
  refuser: "Diffusion hors équipe refusée.",
};
const NIVEAUX = ["N0 grand public", "N1 observateur", "N2 membre", "N3 membre actif", "N4 équipe", "N5 coordination"];
---
<Base titre={p?.titre ?? "Projet"}>
  <p class="surtitre"><a href="/membre">Espace membres</a> · <a href="/membre/projets">Projets</a></p>
  {Astro.url.searchParams.get("cree") && <p class="pastille" role="status">Projet créé. Réglez maintenant sa diffusion (il est invisible hors de son équipe).</p>}
  {fait && FAITS[fait] && <p class="pastille" role="status">{FAITS[fait]}</p>}
  {message && <p class="avertissement" role="alert">{message}</p>}

  {p && (
    <>
      <section class="hero">
        <h1 class="titre">{p.titre}</h1>
        <p class="lead">
          {[NATURES[p.nature] ?? p.nature, p.theme, p.territoire].filter(Boolean).join(" · ")}
          {p.etape && <> · <strong>{libEtape(p.etape)}</strong>{p.etape_verrouillee && <span class="etiquette">verrouillée</span>}</>}
        </p>
        {p.phrase && <p>{p.phrase}</p>}
        {p.resume && (p.niveau < 4 || p.resume_valide) && <p>{p.resume}</p>}
        {p.enjeux && (p.niveau < 4 || p.enjeux_valide) && <p class="enjeux"><strong>Enjeux.</strong> {p.enjeux}</p>}
        {p.lead && profilCtg(p.lead.id, chargerContenu().liens.changethegame_guilde) && <p class="doux">Pilotage : <a href={profilCtg(p.lead.id, chargerContenu().liens.changethegame_guilde)!} rel="noopener">{p.lead.nom ?? "profil"} sur ChangeTheGame</a></p>}
        {(p.personnes ?? []).length > 0 && (
          <p class="doux">Personnes impliquées : {p.personnes!.map((x, i) => (
            <>{i > 0 && ", "}{x.id && profilCtg(x.id, chargerContenu().liens.changethegame_guilde) ? <a href={profilCtg(x.id, chargerContenu().liens.changethegame_guilde)!} rel="noopener">{x.nom}</a> : x.nom} <span class="role">({x.role.toLowerCase()})</span></>
          ))}</p>
        )}
        <p class="doux" style="font-size:.9rem">Vous voyez ce projet au niveau {NIVEAUX[p.niveau] ?? p.niveau}.</p>
      </section>

      {p.elements.length > 0 && (
        <section class="bloc">
          <h2>Contenu</h2>
          <dl class="elements">
            {p.elements.map((e) => (<><dt>{libellesTypes[e.type] ?? e.type}</dt><dd>{e.texte}</dd></>))}
          </dl>
        </section>
      )}
      {p.documents.length > 0 && (
        <section class="bloc">
          <h2>Documents</h2>
          <ul class="simple">{p.documents.map((d) => <li><a href={d.reference} rel="noopener noreferrer" target="_blank">{d.titre}</a></li>)}</ul>
        </section>
      )}

      {droits && droits.niveau >= 4 && (
        <p class="rangee"><a class="bouton" href={`/membre/projets/${encodeURIComponent(id)}/pilote`}>Ouvrir le Pilote</a> <span class="doux">tableau par couloirs et planning, comme l'artefact</span></p>
      )}

      {taches.length > 0 && (
        <section class="bloc" id="taches">
          <h2>Tâches <span class="doux" style="font-size:1rem">({taches.filter((t) => t.statut === "fait").length}/{taches.filter((t) => !t.absence).length} faites)</span></h2>
          {retours?.peut && (
            <p class="doux">Ce projet est une copie du Pilote : vos changements partent à l'artefact et s'appliquent ici au prochain import.</p>
          )}
          <ListeTaches taches={taches} retour={ici} versArtefact={retours?.peut ? { projet: id, enAttente: retours.en_attente } : undefined} />
          {retours?.peut && (
            <details class="proposer">
              <summary>Proposer une tâche à l'artefact</summary>
              <form method="post" class="formulaire">
                <input type="hidden" name="action" value="proposition" /><input type="hidden" name="vers_artefact" value="1" />
                <input type="hidden" name="projet" value={id} />
                <label>Titre <input name="titre" required maxlength="300" /></label>
                <label>Pourquoi, détails (facultatif) <textarea name="texte" rows="3" maxlength="4000"></textarea></label>
                <button class="bouton creux">Envoyer la proposition</button>
              </form>
              {retours.en_attente.filter((r) => r.action === "proposition").length > 0 && (
                <p class="doux">En attente dans l'artefact : {retours.en_attente.filter((r) => r.action === "proposition").map((r) => r.titre).join(" · ")}</p>
              )}
            </details>
          )}
        </section>
      )}

      {droits?.candidater && (
        <form method="post" class="panneau bloc formulaire">
          <h2>Rejoindre ce projet</h2>
          <input type="hidden" name="action" value="candidater" />
          <label for="role">Rôle souhaité</label>
          <select id="role" name="role">{Object.entries(ROLES_CONTEXTUELS).map(([c, l]) => <option value={c}>{l}</option>)}</select>
          <label for="message">Ce que vous apporteriez</label>
          <textarea id="message" name="message" rows="3" maxlength="2000"></textarea>
          <div><button type="submit">Je veux en être</button></div>
        </form>
      )}
      {droits?.candidature_en_attente && <p class="avertissement">Votre candidature est en attente de réponse de l'équipe.</p>}

      {droits?.valider_diffusion && droits.reglages && (
        <form method="post" class="panneau bloc">
          <h2>Validation externe</h2>
          <p>Diffusion hors équipe : <strong>{droits.reglages.diffusion_validee ? "validée" : "pas encore validée"}</strong> ({droits.reglages.validateur_externe}).</p>
          <div class="rangee">
            <button type="submit" name="action" value="valider">Valider la diffusion</button>
            <button type="submit" name="action" value="refuser" class="bouton creux">Refuser</button>
          </div>
        </form>
      )}

      {droits && droits.niveau >= 5 && (
        <form method="post" class="panneau bloc formulaire">
          <h2>Nature du projet</h2>
          <input type="hidden" name="action" value="nature" />
          <label for="nature">Nature <span class="doux">(décide de la quête ChangeTheGame : mission → MISSION ; projet et groupe de travail → PROJECT ; idée → IDEA ; opportunité → pas de quête)</span></label>
          <select id="nature" name="nature">{Object.entries(NATURES).map(([c, l]) => <option value={c} selected={c === p!.nature}>{l}</option>)}</select>
          <div><button type="submit">Changer la nature</button></div>
        </form>
      )}

      {droits?.gerer && (
        <form method="post" class="panneau bloc formulaire">
          <h2>Étape du projet</h2>
          <input type="hidden" name="action" value="etape" />
          <label for="vers">Nouvelle étape</label>
          <select id="vers" name="vers">{listeEtapes.map((e) => <option value={e.code} selected={e.code === p!.etape}>{e.libelle}</option>)}</select>
          <label for="justification">Pourquoi</label>
          <input id="justification" name="justification" maxlength="500" placeholder="Ex. : convention signée le 20/11" />
          <p class="doux" style="font-size:.9rem">« Clos » ou « Abandonné » met fin à tous les badges du projet ; l'équipe garde la lecture 3 mois.</p>
          <div class="rangee">
            <button type="submit">Changer l'étape</button>
            {p.etape_verrouillee && <button type="submit" name="action" value="deverrouiller" class="bouton creux" formnovalidate>Rendre la main aux agents</button>}
          </div>
        </form>
      )}

      {publication && (
        <section class="panneau bloc" id="ctg">
          <h2>ChangeTheGame</h2>
          {publication.ctg_quete_id ? (
            <>
              <p>Publié comme quête{publication.audience === "guilde" ? " réservée à la guilde" : ""} : <a href={adresseQueteCtg(publication.ctg_quete_id, chargerContenu().liens.changethegame_guilde) ?? "#"} rel="noopener">voir sur ChangeTheGame</a>.</p>
              {publication.coordination && (
                <form method="post" class="rangee">
                  <button type="submit" name="action" value="retirer_ctg" class="bouton creux">Retirer le lien</button>
                </form>
              )}
            </>
          ) : publication.validee_le ? (
            <>
              <p>Publication validée par la coordination : la quête reste à créer dans ChangeTheGame.</p>
              {publication.coordination ? <FaceCtgBloc face={publication} projet={p.id} action={ici} lienGuilde={chargerContenu().liens.changethegame_guilde} /> : <p class="doux">La coordination crée la quête et y colle son lien.</p>}
            </>
          ) : publication.proposition_en_attente ? (
            <p>Publication proposée : elle attend la validation de la coordination dans la <a href="/membre/revue">file de revue</a>.</p>
          ) : !publication.publiable ? (
            <>
              <p>Pas encore publiable sur ChangeTheGame :</p>
              <ul>{publication.raisons.map((r) => <li>{r}</li>)}</ul>
            </>
          ) : publication.peut_proposer ? (
            <form method="post" class="formulaire">
              <p>Ce projet peut devenir une quête {publication.audience === "public" ? "publique" : "réservée aux membres de la guilde"} de ChangeTheGame. Seuls le titre, le résumé validé, la nature, le territoire et les étiquettes y partent ; le détail reste ici.</p>
              <input type="hidden" name="action" value="proposer_ctg" />
              <label for="message-ctg">Pourquoi la publier <span class="doux">(facultatif)</span></label>
              <input id="message-ctg" name="message" maxlength="1000" placeholder="Ex. : trouver des partenaires sur le territoire" />
              <div><button type="submit">Proposer la publication</button></div>
            </form>
          ) : (
            <p class="doux">Publiable : le référent du projet peut proposer sa publication.</p>
          )}
        </section>
      )}

      {droits?.fixer_sensibilite && (
        <form method="post" class="panneau bloc formulaire" id="resume">
          <h2>Résumé et enjeux</h2>
          <p class="doux">Sans noms de personnes ni montants. Une fois validés, le résumé s'affiche pour les niveaux qui voient le titre du projet ; les enjeux, pour ceux qui voient ses besoins (actifs, alliés et partenaires pendant le projet, ou tout le monde si les besoins sont publics).</p>
          <label for="resume-texte">Résumé <span class="doux">(1 à 2 phrases{p.resume ? <> · {p.resume_valide ? "validé" : "brouillon à valider"}</> : null})</span></label>
          <textarea id="resume-texte" name="resume" rows="3" maxlength="600">{p.resume ?? ""}</textarea>
          <label for="enjeux-texte">Enjeux <span class="doux">(2 à 3 phrases : ce qui se joue, opportunité, besoin repéré{p.enjeux ? <> · {p.enjeux_valide ? "validés" : "brouillon à valider"}</> : null})</span></label>
          <textarea id="enjeux-texte" name="enjeux" rows="4" maxlength="1200">{p.enjeux ?? ""}</textarea>
          <div class="rangee">
            <button type="submit" name="action" value="resume_valider">Enregistrer et valider</button>
            <button type="submit" name="action" value="resume" class="bouton creux">Enregistrer comme brouillon</button>
            {(p.resume_valide || p.enjeux_valide) && <button type="submit" name="action" value="resume_retirer" class="bouton creux">Retirer la validation</button>}
          </div>
        </form>
      )}

      {droits?.fixer_sensibilite && droits.reglages && (
        <form method="post" class="panneau bloc formulaire">
          <h2>Diffusion hors de l'équipe</h2>
          <input type="hidden" name="action" value="diffusion" />
          <fieldset>
            <legend>Sensibilité</legend>
            {Object.entries(SENSIBILITES).map(([c, l]) => (
              <label class="option"><input type="radio" name="sensibilite" value={c} checked={droits!.reglages!.sensibilite === c} /> {l}</label>
            ))}
          </fieldset>
          <label class="option"><input type="checkbox" name="titre_public" checked={droits.reglages.titre_public_autorise} /> Projet sensible : montrer le titre et une phrase hors équipe</label>
          <label for="phrase">Phrase publique (projet sensible)</label>
          <input id="phrase" name="phrase" maxlength="300" value={droits.reglages.phrase_publique ?? ""} />
          <label for="validateur">Validateur externe <span class="doux">(ex. une fondation qui doit approuver toute diffusion ; vide s'il n'y en a pas)</span></label>
          <input id="validateur" name="validateur" maxlength="200" value={droits.reglages.validateur_externe ?? ""} />
          <label class="option"><input type="checkbox" name="besoins_publics" checked={droits.reglages.besoins_publics} /> Les besoins du projet peuvent circuler publiquement</label>
          <div><button type="submit">Enregistrer</button></div>
        </form>
      )}

      {droits && droits.niveau >= 4 && (
        <section class="panneau bloc">
          <h2>Aperçu en tant que</h2>
          <p class="doux">Ce que voit chaque niveau, sans rien changer.</p>
          <div class="rangee">
            {NIVEAUX.slice(0, droits.niveau + 1).map((l, n) => (
              <a class={`bouton ${String(n) === niveauApercu ? "" : "creux"}`} href={`${ici}?en_tant_que=${n}#apercu`}>{l}</a>
            ))}
          </div>
          {niveauApercu !== null && (
            <div id="apercu" class="apercu">
              {!apercu ? <p><strong>Invisible</strong> à ce niveau.</p> : (
                <>
                  <p><strong>{apercu.titre}</strong>{apercu.etape ? ` · ${libEtape(apercu.etape)}` : " · étape masquée"}{apercu.phrase ? ` — ${apercu.phrase}` : ""}</p>
                  {apercu.resume ? <p>{apercu.resume}</p> : p.resume && (
                    <p class="doux">Résumé : {p.resume_valide ? "masqué à ce niveau." : <>pas encore visible, il est en <a href="#resume">brouillon à valider</a>.</>}</p>
                  )}
                  {apercu.enjeux ? <p class="enjeux"><strong>Enjeux.</strong> {apercu.enjeux}</p> : p.enjeux && (
                    <p class="doux">Enjeux : {p.enjeux_valide ? "masqués à ce niveau." : <>pas encore visibles, ils sont en <a href="#resume">brouillon à valider</a>.</>}</p>
                  )}
                  {(apercu.personnes ?? []).length > 0 && <p class="doux">Personnes impliquées : {apercu.personnes!.map((x) => x.nom).join(", ")}</p>}
                  {apercu.lead && profilCtg(apercu.lead.id, chargerContenu().liens.changethegame_guilde) && (
                    <p class="doux">Pilotage : <a href={profilCtg(apercu.lead.id, chargerContenu().liens.changethegame_guilde)!} rel="noopener">{apercu.lead.nom ?? "profil"} sur ChangeTheGame</a></p>
                  )}
                  {apercu.elements.length === 0 ? (!apercu.resume && !apercu.enjeux && <p class="doux">Aucun autre contenu à ce niveau.</p>) : (
                    <dl class="elements">{apercu.elements.map((e) => (<><dt>{libellesTypes[e.type] ?? e.type}</dt><dd>{e.texte}</dd></>))}</dl>
                  )}
                  {apercu.documents.length > 0 && <p class="doux">Documents : {apercu.documents.map((d) => d.titre).join(", ")}</p>}
                </>
              )}
            </div>
          )}
        </section>
      )}
    </>
  )}
</Base>

<style>
  .titre { overflow-wrap: anywhere; }
  .enjeux { max-width: 70ch; color: var(--doux); }
  .elements { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: 8px 18px; margin: 0; }
  .elements dt { font-weight: 600; } .elements dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 620px) { .elements { grid-template-columns: minmax(0, 1fr); } .elements dd { margin-bottom: 8px; } }
  .formulaire { display: grid; gap: 8px; }
  .formulaire input:not([type=radio]):not([type=checkbox]), .formulaire select, .formulaire textarea { width: 100%; font: inherit; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 6px; }
  .option { display: flex; gap: 8px; align-items: flex-start; }
  .apercu { border-top: 1px solid var(--trait); padding-top: 12px; display: grid; gap: 8px; }
</style>
