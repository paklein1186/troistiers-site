---
import Base from "../../../layouts/Base.astro";
import { acteurConnecte, messageBase } from "../../../lib/acteur";
import { baseConfiguree, creerProjet, etapes, NATURES, pilotesVisibles, projetsVisibles, type PiloteVisible, type ProjetVu } from "../../../lib/base";

// Projets et missions de la base Trois-Tiers, tels que la personne connectée a le droit de les voir
// (niveaux N0 à N5, sensibilité, étape : tout est filtré par la base).
const u = Astro.locals.utilisateur;
const ici = "/membre/projets";
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
const acteur = await acteurConnecte(Astro.cookies);

let message = "";
let saisie = { nature: "projet", titre: "", theme: "", territoire: "" };
if (Astro.request.method === "POST" && acteur && baseConfiguree()) {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  const f = await Astro.request.formData();
  saisie = {
    nature: String(f.get("nature") ?? "projet"),
    titre: String(f.get("titre") ?? "").trim().slice(0, 200),
    theme: String(f.get("theme") ?? "").trim().slice(0, 200),
    territoire: String(f.get("territoire") ?? "").trim().slice(0, 200),
  };
  if (!NATURES[saisie.nature] || saisie.titre.length < 3) message = "Choisissez une nature et donnez un titre.";
  else {
    try {
      const id = await creerProjet(acteur, saisie);
      return Astro.redirect(`${ici}/${encodeURIComponent(id)}?cree=1`, 303);
    } catch (e) {
      console.error("Base Trois-Tiers (création) :", e);
      message = (e as { code?: string })?.code === "42501"
        ? "Proposer un projet est réservé aux membres qui cotisent."
        : messageBase(e);
    }
  }
}

let projets: ProjetVu[] = [];
let libellesEtapes: Record<string, string> = {};
let pilotes: PiloteVisible[] = [];
if (baseConfiguree()) {
  try {
    [projets, libellesEtapes, pilotes] = await Promise.all([
      projetsVisibles(acteur),
      etapes().then((l) => Object.fromEntries(l.map((e) => [e.code, e.libelle]))),
      acteur ? pilotesVisibles(acteur).catch(() => []) : Promise.resolve([]),
    ]);
  } catch (e) {
    console.error("Base Trois-Tiers (liste) :", e);
    message ||= "Les projets n'ont pas pu être chargés.";
  }
}
---
<Base titre="Projets et missions">
  <p class="surtitre"><a href="/membre">Espace membres</a> · Projets</p>
  <section class="hero">
    <h1>Projets et missions</h1>
    <p class="lead">Les projets du réseau que vous pouvez voir, selon votre adhésion et votre rôle dans chacun. Ce qui est réservé à une équipe le reste.</p>
  </section>

  {!baseConfiguree() ? (
    <p class="avertissement">La base Trois-Tiers n'est pas encore branchée à ce site.</p>
  ) : (
    <>
      {message && <p class="avertissement" role="alert">{message}</p>}
      {pilotes.length > 0 && (
        <div class="pilotes">
          {pilotes.map((p) => (
            <a class="pilote-carte" href={`/membre/pilotes/${encodeURIComponent(p.source)}`}>
              <b>{p.titre}</b>
              <span class="doux">Tableau de bord · {p.missions} missions, tâches, journal</span>
            </a>
          ))}
        </div>
      )}
      {projets.length === 0 ? (
        <p class="doux">Aucun projet visible pour l'instant.</p>
      ) : (
        <ul class="projets">
          {projets.map((p) => (
            <li>
              <a href={`${ici}/${encodeURIComponent(p.id)}`}><b>{p.titre}</b></a>
              <span class="etiquette">{NATURES[p.nature] ?? p.nature}</span>
              {p.niveau >= 4 && <span class="pastille">Votre équipe</span>}
              <p class="doux">
                {[p.theme, p.territoire, p.etape ? libellesEtapes[p.etape] ?? p.etape : null].filter(Boolean).join(" · ") || (p.phrase ?? "")}
              </p>
            </li>
          ))}
        </ul>
      )}

      {acteur && (
        <details class="panneau bloc" open={!!message && saisie.titre !== ""}>
          <summary><strong>Proposer un projet, une mission ou une idée</strong></summary>
          <form method="post" class="formulaire">
            <label for="nature">Nature</label>
            <select id="nature" name="nature">
              {Object.entries(NATURES).map(([code, lib]) => <option value={code} selected={code === saisie.nature}>{lib}</option>)}
            </select>
            <label for="titre">Titre</label>
            <input id="titre" name="titre" required minlength="3" maxlength="200" value={saisie.titre} />
            <label for="theme">Thème <span class="doux">(facultatif)</span></label>
            <input id="theme" name="theme" maxlength="200" value={saisie.theme} />
            <label for="territoire">Territoire <span class="doux">(facultatif)</span></label>
            <input id="territoire" name="territoire" maxlength="200" value={saisie.territoire} />
            <p class="doux" style="font-size:.9rem">Vous en devenez l'initiatrice ou l'initiateur. Le projet reste invisible hors de son équipe tant que vous n'avez pas réglé sa diffusion.</p>
            <div><button type="submit">Créer</button></div>
          </form>
        </details>
      )}
    </>
  )}
</Base>

<style>
  .pilotes { display: grid; gap: 10px; margin-bottom: 18px; }
  .pilote-carte { display: grid; gap: 2px; padding: 14px 16px; border: 1px solid var(--trait); border-left: 4px solid var(--accent); border-radius: 10px; background: var(--surface); text-decoration: none; color: var(--encre); }
  .pilote-carte:hover { border-color: var(--accent); }
  .projets { list-style: none; margin: 0; padding: 0; }
  .projets li { padding-block: 12px; border-top: 1px solid var(--trait); overflow-wrap: anywhere; }
  .projets .pastille { margin-left: 6px; }
  .projets p { margin-top: 2px; font-size: .94rem; }
  details summary { cursor: pointer; min-height: 32px; }
  .formulaire { display: grid; gap: 8px; margin-top: 12px; max-width: 560px; }
  .formulaire input, .formulaire select { width: 100%; }
</style>
