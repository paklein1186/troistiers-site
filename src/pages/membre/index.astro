---
import Base from "../../layouts/Base.astro";
import { chargerCommunaute } from "../../lib/config";
import { badgesValides, carteDesAcces } from "../../lib/acces";
import { formulesDuProfil } from "../../lib/config";
import { jetonsValides, listerCodes, type CodeAchete } from "../../lib/ctg";
import { garderJetons, lireJetons } from "../../lib/jetons";
import { niveauAcces } from "../../lib/acces";
import { chargerEnquetes, type Enquete } from "../../lib/space2";

const u = Astro.locals.utilisateur;
if (!u) return Astro.redirect("/connexion");

const c = chargerCommunaute();
const acces = carteDesAcces(c, u);
const badges = badgesValides(u);
const libelles: Record<string, string> = {
  aucun: "Fermé", resume: "Résumé", agrege: "Vues agrégées", filtre: "Filtré (vos missions, votre territoire)", complet: "Complet",
};
// Codes achetés pour d'autres (GAL, organisation) : affichés seulement s'il y en a.
let codes: CodeAchete[] = [];
const jetons = await jetonsValides(lireJetons(Astro.cookies));
if (jetons) {
  garderJetons(Astro.cookies, jetons);
  try {
    codes = await listerCodes(jetons.acces);
  } catch (e) {
    console.error("Codes d'adhésion :", e);
  }
}
const pourQui = (planCode: string) => {
  const profil = c.correspondances_ctg?.formules?.[planCode];
  const libelle = profil ? c.profils[profil]?.libelle ?? profil : planCode;
  const choix = c.correspondances_ctg?.choix?.[planCode]?.libelle;
  return profil && choix && formulesDuProfil(c, profil).length > 1 ? `${libelle} · ${choix}` : libelle;
};
const lien = (code: string) => `${Astro.url.origin}/code?c=${code}`;
const nbLibres = codes.filter((x) => !x.used).length;

// « Nourrir votre lieu » : entretien Space2 et enquêtes en cours (espace nourrir_lieu de communaute.yaml).
const nourrir = niveauAcces(c, u, "nourrir_lieu") !== "aucun";
const bibliotheque = niveauAcces(c, u, "bibliotheque") !== "aucun";
const groupes: Record<string, string> = { public: "Partie publique", membre: "Espace membre", cle: "Clés", gouvernance: "Gouvernance", outil: "Outils" };
// Outils ouverts à cette personne, d'après communaute.yaml (groupe « outil »).
const outils = acces.filter((e) => e.groupe === "outil" && e.niveau !== "aucun" && e.lien);

// Menu de l'espace membres : un onglet par rubrique ouverte à la personne (?onglet=…, sans JavaScript).
const onglets = [
  nourrir && { id: "lieu", libelle: "Mon lieu" },
  bibliotheque && { id: "bibliotheque", libelle: "Bibliothèque" },
  outils.length > 0 && { id: "outils", libelle: "Outils", nombre: outils.length },
  codes.length > 0 && { id: "codes", libelle: "Codes d'adhésion", nombre: nbLibres || undefined },
  { id: "compte", libelle: "Mon compte" },
].filter((o): o is { id: string; libelle: string; nombre?: number } => Boolean(o));
const demande = Astro.url.searchParams.get("onglet") ?? (Astro.url.searchParams.get("profil") ? "compte" : "");
const onglet = onglets.find((o) => o.id === demande)?.id ?? onglets[0].id;

let enquetes: Enquete[] = [];
if (nourrir && onglet === "lieu") {
  try {
    enquetes = await chargerEnquetes();
  } catch (e) {
    console.error("Enquêtes Space2 :", e);
  }
}

const adhesion = Astro.url.searchParams.get("adhesion");
const messagesAdhesion: Record<string, string> = {
  code: "Bienvenue ! Votre code est activé : votre adhésion est active, avec le badge « Adhérent » et ses accès.",
  active: "Merci ! Votre adhésion est active : le badge « Adhérent » et ses accès sont à vous.",
  attente: "Merci ! Le paiement est en cours de validation chez Stripe : votre badge « Adhérent » apparaîtra dans quelques minutes (bouton « Actualiser mon profil » plus bas).",
  erreur: "Le paiement a bien été reçu par Stripe, mais l'activation n'a pas pu être confirmée tout de suite. Elle se fera automatiquement ; sinon, écrivez à l'équipe.",
};
const profilMaj = Astro.url.searchParams.get("profil");
---
<Base titre="Espace membre">
  {adhesion && messagesAdhesion[adhesion] && <p class="avertissement" role="status">{messagesAdhesion[adhesion]}</p>}
  {profilMaj === "actualise" && <p class="avertissement" role="status">Profil relu chez ChangeTheGame.</p>}
  {profilMaj === "erreur" && <p class="avertissement" role="status">Le profil n'a pas pu être relu chez ChangeTheGame. Réessayez plus tard.</p>}
  <h1>Bonjour{u.nom ? `, ${u.nom}` : ""}</h1>
  <p class="chapo">Profil : <strong>{c.profils[u.profil]?.libelle ?? u.profil}</strong> · {u.email}</p>
  <p>
    {badges.length
      ? badges.map((b) => <span class="pastille" style="margin-right:6px">{c.badges[b.id]?.libelle ?? b.id}{b.portee ? ` · ${b.portee.type} ${b.portee.id}` : ""}{b.expire_le ? ` · jusqu'au ${b.expire_le.slice(0, 10)}` : ""}</span>)
      : <span style="color:var(--doux)">Aucun badge : vous voyez la partie publique et les annonces de la communauté.</span>}
  </p>

  {!badges.some((b) => b.id === "adherent") && u.profil !== "equipe" && (
    <p><a class="bouton" href="/adherer">Adhérer à Trois-Tiers</a></p>
  )}

  <nav class="onglets-membre" aria-label="Rubriques de l'espace membres">
    {onglets.map((o) => (
      <a href={`/membre?onglet=${o.id}`} aria-current={o.id === onglet ? "page" : undefined}>
        {o.libelle}{o.nombre ? <span class="compte">{o.nombre}</span> : null}
      </a>
    ))}
  </nav>

  {onglet === "lieu" && (
    <section class="panneau-onglet" id="panneau-lieu" aria-labelledby="titre-lieu">
      <h2 id="titre-lieu">Nourrir votre lieu</h2>
      <p>Plus la fiche de votre lieu est complète, mieux le réseau peut vous relier à des pairs, des ressources et des soutiens. Elle alimente la carte, le Portfolio et l'observatoire.</p>
      <div class="t2">
        <div class="cellule">
          <h3>Présenter ou mettre à jour votre lieu</h3>
          <p>Un entretien de quelques minutes avec Space2 : activités, publics, bâtiment, gouvernance, besoins. Vous pouvez le reprendre là où vous l'avez laissé.</p>
          <p><a class="bouton" href="/membre/entretien">Commencer l'entretien</a></p>
        </div>
        <div class="cellule">
          <h3>Enquêtes en cours</h3>
          {enquetes.length === 0 ? (
            <p class="doux">Aucune enquête ouverte en ce moment.</p>
          ) : (
            <ul class="simple">
              {enquetes.map((q) => (
                <li>
                  <a href={`/membre/entretien?enquete=${encodeURIComponent(q.code)}`}><strong>{q.titre}</strong></a>
                  {q.date_fin && <span class="doux"> · jusqu'au {q.date_fin.slice(0, 10)}</span>}
                  {q.description && <br />}{q.description && <span class="doux" style="font-size:.94rem">{q.description}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  {onglet === "bibliotheque" && (
    <section class="panneau-onglet" id="panneau-bibliotheque" aria-labelledby="titre-bibliotheque">
      <h2 id="titre-bibliotheque">Bibliothèque</h2>
      <p>Posez vos questions à l'assistant de Space2 (en léger, moyen ou profond) : il cherche dans ce que les lieux et les membres du réseau ont partagé et cite ses sources. Vos conversations sont gardées.</p>
      <div class="rangee">
        <a class="bouton" href="/membre/bibliotheque">Interroger la bibliothèque</a>
        <a class="bouton creux" href="/membre/bibliotheque/contribuer">Nourrir la bibliothèque</a>
        <a class="bouton creux" href="/membre/bibliotheque/packs">Acheter des questions</a>
      </div>
    </section>
  )}

  {onglet === "outils" && (
    <section class="panneau-onglet" id="panneau-outils" aria-labelledby="titre-outils">
      <h2 id="titre-outils">Vos outils</h2>
      <div class="t3">
        {outils.map((o) => (
          <div class="cellule">
            <h3>{o.libelle}{o.lien?.startsWith("https://claude.ai") && <span class="etiquette">claude.ai</span>}</h3>
            {o.description && <p>{o.description}</p>}
            <a href={o.lien} rel="noopener">Ouvrir</a>
          </div>
        ))}
      </div>
      <p class="doux" style="font-size:.92rem">Les outils marqués « claude.ai » s'ouvrent sur claude.ai, seulement s'ils sont partagés avec vous ; les autres sont des copies tenues à jour sur ce site.</p>
    </section>
  )}

  {onglet === "codes" && (
    <section class="panneau-onglet" id="panneau-codes" aria-labelledby="titre-codes">
      <h2 id="titre-codes">Vos codes d'adhésion</h2>
      <p class="doux">
        Vous avez payé {codes.length} {codes.length > 1 ? "places" : "place"} ({nbLibres} {nbLibres > 1 ? "encore libres" : "encore libre"}).
        Transmettez à chaque lieu ou personne son code, ou directement son lien : il active l'adhésion avec son propre compte.
        Chaque code ne sert qu'une fois.
      </p>
      <div class="defile">
        <table>
          <thead><tr><th>Code</th><th>Pour</th><th>Valable jusqu'au</th><th>État</th><th>Lien à transmettre</th></tr></thead>
          <tbody>
            {codes.map((x) => (
              <tr style={x.used ? "color:var(--doux)" : ""}>
                <td style="font-family:ui-monospace,monospace;white-space:nowrap">{x.code}</td>
                <td>{pourQui(x.plan_code)}</td>
                <td style="white-space:nowrap">{x.valid_until?.slice(0, 10) ?? "—"}</td>
                <td>{x.used ? `Utilisé le ${x.used_at?.slice(0, 10)}` : "Libre"}</td>
                <td>{x.used ? "—" : <button type="button" class="copier" data-lien={lien(x.code)} style="padding:4px 10px;font-size:13px">Copier le lien</button>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {onglet === "compte" && (
    <section class="panneau-onglet" id="panneau-compte" aria-labelledby="titre-compte">
      <h2 id="titre-compte">Mon compte</h2>
      <p class="doux">Votre profil et vos badges viennent de ChangeTheGame. Ce tableau montre ce que chaque espace vous ouvre.</p>
      <div class="defile">
        <table>
          <thead><tr><th>Espace</th><th>Où</th><th>Votre accès</th></tr></thead>
          <tbody>
            {acces.map((e) => (
              <tr style={e.niveau === "aucun" ? "color:var(--doux)" : ""}>
                <td>{e.libelle}</td><td>{groupes[e.groupe]}</td><td>{libelles[e.niveau]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="rangee">
        {!u.email.startsWith("demo+") && <form method="post" action="/membre/actualiser"><button type="submit">Actualiser mon profil</button></form>}
        <form method="post" action="/deconnexion"><button type="submit" class="bouton creux">Se déconnecter</button></form>
      </div>
    </section>
  )}
</Base>

<style>
  .onglets-membre { display: flex; gap: 4px; margin: 32px 0 0; border-bottom: 1px solid var(--trait); overflow-x: auto; scrollbar-width: thin; }
  .onglets-membre a { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 14px; text-decoration: none; color: var(--doux); font-weight: 600; border-bottom: 3px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  .onglets-membre a:hover { color: var(--encre); }
  .onglets-membre a[aria-current="page"] { color: var(--encre); border-bottom-color: var(--accent); }
  .onglets-membre .compte { font: 500 .74rem var(--mono); background: var(--accent-doux); color: var(--accent); border-radius: 999px; padding: 1px 7px; }
  .panneau-onglet { display: grid; gap: 16px; margin-top: 24px; }
</style>

<script>
  // Sur téléphone, le menu défile de côté : l'onglet ouvert reste visible.
  document.querySelector<HTMLElement>('.onglets-membre a[aria-current="page"]')?.scrollIntoView({ block: "nearest", inline: "nearest" });
  // « Copier le lien » d'un code d'adhésion.
  document.querySelectorAll<HTMLButtonElement>("button.copier").forEach((b) => {
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.lien ?? "");
        b.textContent = "Lien copié";
      } catch {
        window.prompt("Copiez ce lien :", b.dataset.lien ?? "");
      }
    });
  });
</script>
