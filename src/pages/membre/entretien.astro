---
import Base from "../../layouts/Base.astro";
import { chargerCommunaute } from "../../lib/config";
import { niveauAcces } from "../../lib/acces";
import { jetonsValides } from "../../lib/ctg";
import { garderJetons, lireJetons } from "../../lib/jetons";
import { chargerContenu } from "../../lib/contenu";
import { lienSpace2, ticketSiPossible } from "../../lib/space2";

// Entretien (ou enquête) Space2 affiché DANS le site, sous son menu : Space2 en mode intégré
// (?embed=true, sans ses barres ni son menu), déjà connecté grâce au ticket de connexion unique.
const u = Astro.locals.utilisateur;
const enquete = (Astro.url.searchParams.get("enquete") ?? "").slice(0, 100) || undefined;
if (!u) {
  const suite = `/membre/entretien${enquete ? `?enquete=${encodeURIComponent(enquete)}` : ""}`;
  return Astro.redirect(`/connexion?suite=${encodeURIComponent(suite)}`);
}
if (niveauAcces(chargerCommunaute(), u, "nourrir_lieu") === "aucun") return Astro.redirect("/membre");

const jetons = await jetonsValides(lireJetons(Astro.cookies));
if (jetons) garderJetons(Astro.cookies, jetons);
const ticket = await ticketSiPossible(jetons?.acces);
const src = lienSpace2(chargerContenu().liens.space2, { enquete, ticket, integre: true });
const pleinEcran = `/space2/entretien${enquete ? `?enquete=${encodeURIComponent(enquete)}` : ""}`;
// La page contient un ticket à usage unique : jamais en cache.
Astro.response.headers.set("cache-control", "private, no-store");
---
<Base titre={enquete ? "Enquête" : "Entretien de votre lieu"}>
  <div class="rangee entete">
    <p class="surtitre" style="margin:0"><a href="/membre#nourrir">Espace membres</a> · {enquete ? "Enquête" : "Entretien de votre lieu"}</p>
    <a class="doux" href={pleinEcran} style="font-size:.9rem">Ouvrir en plein écran</a>
  </div>
  <iframe class="space2" src={src} title="Entretien Space2"
    allow="microphone; clipboard-write" referrerpolicy="no-referrer"></iframe>
  <p class="doux" style="font-size:.85rem">Si Space2 vous demande votre e-mail après un rechargement, revenez par le bouton « Commencer l'entretien » de votre espace membre : vous serez reconnecté.</p>
</Base>

<style>
  .entete { justify-content: space-between; }
  .space2 { display: block; width: 100%; height: calc(100vh - 180px); min-height: 560px; border: 1px solid var(--trait); border-radius: 10px; background: var(--surface); }
</style>
