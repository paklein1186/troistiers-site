---
import Base from "../../layouts/Base.astro";
import { chargerCommunaute } from "../../lib/config";
import { niveauAcces } from "../../lib/acces";
import { markdownEnHtml } from "../../lib/artefacts";
import { poserQuestion, space2Configure, type MessageAssistant } from "../../lib/space2";
import { questionsUtilisees, rendreQuestion, reserverQuestion } from "../../lib/quotas";

// Bibliothèque : questions à l'assistant de Space2 (espace « bibliotheque » de communaute.yaml),
// avec un quota mensuel par personne (assistants.adherent.inclus_par_mois).
const u = Astro.locals.utilisateur;
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent("/membre/bibliotheque")}`);
const c = chargerCommunaute();
const ouvert = niveauAcces(c, u, "bibliotheque") !== "aucun";
const quota = Number((c.assistants?.adherent as { inclus_par_mois?: unknown } | undefined)?.inclus_par_mois) || 0;
const MAX = 4000;

let question = "";
let reponseHtml = "";
let reponseBrute = "";
let precedente: MessageAssistant[] = [];
let message = "";

if (Astro.request.method === "POST" && ouvert && quota > 0) {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  const form = await Astro.request.formData();
  question = String(form.get("question") ?? "").trim().slice(0, MAX);
  // Question de suivi : l'échange précédent est renvoyé avec la nouvelle question.
  const pq = String(form.get("precedente_q") ?? "").slice(0, MAX);
  const pr = String(form.get("precedente_r") ?? "").slice(0, MAX);
  if (pq && pr) precedente = [{ role: "user", content: pq }, { role: "assistant", content: pr }];
  if (question.length < 3) {
    message = "Écrivez votre question (quelques mots au moins).";
  } else if ((await reserverQuestion(u.email, quota)) === null) {
    message = `Vous avez utilisé vos ${quota} questions de ce mois. Le compteur repart à zéro le 1er du mois prochain.`;
  } else {
    try {
      reponseBrute = await poserQuestion([...precedente, { role: "user", content: question }]);
      reponseHtml = markdownEnHtml(reponseBrute);
    } catch (e) {
      await rendreQuestion(u.email);
      console.error("Bibliothèque :", e);
      message = e instanceof Error && e.message === "trop_de_questions"
        ? "Beaucoup de questions en même temps : réessayez dans une minute (cette question n'est pas décomptée)."
        : "L'assistant n'a pas pu répondre. Réessayez ; cette question n'est pas décomptée.";
    }
  }
}
const restantes = Math.max(0, quota - questionsUtilisees(u.email));
---
<Base titre="Bibliothèque">
  <p class="surtitre"><a href="/membre">Espace membres</a> · Bibliothèque</p>
  <section class="hero">
    <h1>Interroger la bibliothèque du réseau</h1>
    <p class="lead">Posez une question en langage courant : l'assistant de Space2 cherche dans ce que les lieux ont partagé (profils, besoins, bonnes pratiques, études) et cite ses sources.</p>
  </section>

  {!ouvert ? (
    <section class="panneau bloc">
      <h2>Réservé aux adhérents</h2>
      <p>La bibliothèque est comprise dans l'adhésion à Trois-Tiers ({quota} questions par mois).</p>
      <div class="rangee"><a class="bouton" href="/adherer">Adhérer</a></div>
    </section>
  ) : !space2Configure() ? (
    <p class="avertissement">La bibliothèque n'est pas encore branchée à Space2.</p>
  ) : (
    <>
      <p class="doux">Questions restantes ce mois-ci : <strong>{restantes}</strong> sur {quota}.</p>
      {message && <p class="avertissement" role="status">{message}</p>}

      {reponseHtml && (
        <section class="bloc">
          <div class="echange">
            <p class="question"><span class="surtitre">Votre question</span><br />{question}</p>
            <article class="reponse document" set:html={reponseHtml} />
          </div>
        </section>
      )}

      <form method="post" class="panneau bloc formulaire" id="formulaire">
        <label for="question"><strong>{reponseHtml ? "Une autre question, ou une précision ?" : "Votre question"}</strong></label>
        <textarea id="question" name="question" rows="4" maxlength={MAX} required
          placeholder="Ex. : quels lieux nourriciers en Wallonie cherchent des bénévoles ? Comment d'autres lieux ont-ils financé leur rénovation ?">{reponseHtml ? "" : question}</textarea>
        {reponseHtml && (
          <>
            <input type="hidden" name="precedente_q" value={question} />
            <input type="hidden" name="precedente_r" value={reponseBrute.slice(0, MAX)} />
            <label style="font-size:.92rem"><input type="checkbox" id="suivi" checked /> Tenir compte de la réponse précédente</label>
          </>
        )}
        <div class="rangee">
          <button type="submit" id="envoyer" disabled={restantes === 0}>Poser la question</button>
          <span class="doux" id="attente" hidden>Recherche en cours… cela peut prendre jusqu'à une minute.</span>
        </div>
        <p class="doux" style="font-size:.85rem;margin:0">Une question compte dans votre quota seulement si l'assistant répond. Les réponses peuvent contenir des erreurs : vérifiez auprès des sources citées.</p>
      </form>
    </>
  )}
</Base>

<style>
  .formulaire textarea { width: 100%; font: inherit; padding: 10px 12px; border: 1px solid var(--trait); border-radius: 8px; background: var(--surface); color: var(--encre); }
  .echange { display: grid; gap: 14px; }
  .question { background: var(--accent-doux); border-radius: 10px; padding: 12px 16px; margin: 0; max-width: 75ch; }
  .reponse { max-width: 75ch; }
  .reponse :global(table) { display: block; overflow-x: auto; font-size: .9rem; }
</style>

<script>
  // Pendant l'attente : bouton désactivé, message visible. Décocher « suivi » retire l'échange précédent.
  const f = document.getElementById("formulaire") as HTMLFormElement | null;
  f?.addEventListener("submit", () => {
    const suivi = document.getElementById("suivi") as HTMLInputElement | null;
    if (suivi && !suivi.checked) f.querySelectorAll('input[type="hidden"]').forEach((i) => i.remove());
    (document.getElementById("envoyer") as HTMLButtonElement).disabled = true;
    document.getElementById("attente")?.removeAttribute("hidden");
  });
</script>
