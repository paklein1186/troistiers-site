---
import Base from "../../../../layouts/Base.astro";
import { chargerCommunaute } from "../../../../lib/config";
import { niveauAcces } from "../../../../lib/acces";
import { acheterPack, ErreurPaiement, jetonsValides, lireSoldeQuestions } from "../../../../lib/ctg";
import { garderJetons, lireJetons } from "../../../../lib/jetons";
import { dateCourte, reglagesBibliotheque } from "../../../../lib/bibliotheque";
import { questionsUtilisees } from "../../../../lib/quotas";

// Packs de questions (décision du 20/11) : en plus des questions du mois comprises dans l'adhésion,
// achetés en euros chez ChangeTheGame (Stripe de Trois-Tiers), sans limite de durée.
const u = Astro.locals.utilisateur;
const ici = "/membre/bibliotheque/packs";
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
const c = chargerCommunaute();
if (niveauAcces(c, u, "bibliotheque") === "aucun") return Astro.redirect("/membre/bibliotheque");
const jetons = await jetonsValides(lireJetons(Astro.cookies));
if (!jetons) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
garderJetons(Astro.cookies, jetons);
const { quota } = reglagesBibliotheque(c);

const MESSAGES: Record<string, string> = {
  reconnexion: "Votre connexion à ChangeTheGame a expiré : reconnectez-vous puis recommencez.",
  paiement_ferme: "L'achat de questions n'est pas ouvert pour le moment.",
  membre: "L'achat de questions est réservé aux membres de la guilde Trois-Tiers.",
  pack: "Ce pack n'est plus proposé : choisissez-en un autre.",
  paiement: "Le paiement n'a pas pu démarrer. Réessayez dans un instant.",
};
let message = "";
if (Astro.request.method === "POST") {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  const code = String((await Astro.request.formData()).get("pack") ?? "");
  if (/^[a-z0-9_]{1,60}$/.test(code)) {
    try {
      return Astro.redirect(await acheterPack(jetons.acces, code, `${Astro.url.origin}${ici}/retour`), 303);
    } catch (e) {
      console.error("Achat de questions :", e);
      message = MESSAGES[e instanceof ErreurPaiement ? e.code : "paiement"] ?? MESSAGES.paiement;
    }
  }
}
const etat = Astro.url.searchParams.get("etat");
const ETATS: Record<string, string> = {
  ok: "Merci ! Vos questions sont ajoutées à votre solde.",
  attente: "Merci ! Le paiement est en cours de validation chez Stripe : vos questions apparaîtront dans quelques minutes.",
  annule: "Achat annulé : rien n'a été payé.",
  erreur: "Le paiement a été reçu par Stripe, mais le crédit n'a pas pu être confirmé tout de suite. Il se fera automatiquement ; sinon, écrivez à l'équipe.",
};
const s = await lireSoldeQuestions(jetons.acces);
const restantes = Math.max(0, quota - questionsUtilisees(u.email));
const euros = (cents: number, devise: string) =>
  new Intl.NumberFormat("fr-BE", { style: "currency", currency: devise.toUpperCase(), minimumFractionDigits: cents % 100 ? 2 : 0 }).format(cents / 100);
---
<Base titre="Acheter des questions">
  <p class="surtitre"><a href="/membre">Espace membres</a> · <a href="/membre/bibliotheque">Bibliothèque</a> · Questions</p>
  <section class="hero">
    <h1>Plus de questions à la bibliothèque</h1>
    <p class="lead">Votre adhésion comprend {quota} questions par mois. Au-delà, un pack ajoute des questions, valables sans limite de durée : elles servent dès que celles du mois sont épuisées.</p>
  </section>

  {etat && ETATS[etat] && <p class={etat === "ok" ? "pastille" : "avertissement"} role="status">{ETATS[etat]}</p>}
  {message && <p class="avertissement" role="alert">{message}</p>}

  <div class="soldes">
    <p><span class="chiffre">{restantes}</span><span class="doux">questions du mois restantes, sur {quota}</span></p>
    <p><span class="chiffre">{s.solde}</span><span class="doux">questions achetées disponibles</span></p>
  </div>

  {s.packs.length === 0 ? (
    <p class="avertissement">Aucun pack n'est proposé pour le moment.</p>
  ) : (
    <section class="bloc">
      <h2>Choisir un pack</h2>
      {!s.achetable && <p class="avertissement">L'achat est fermé pour le moment : les packs seront disponibles prochainement.</p>}
      <div class="t2">
        {s.packs.map((p) => (
          <form method="post" class="cellule pack">
            <h3>{p.label}</h3>
            <p class="prix">{euros(p.amount_cents, p.currency)}</p>
            <p class="doux">{p.credits} questions · {(p.amount_cents / p.credits / 100).toLocaleString("fr-BE", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} € la question · {p.valid_months ? `valables ${p.valid_months} mois` : "sans limite de durée"}</p>
            {p.description && <p>{p.description}</p>}
            <input type="hidden" name="pack" value={p.code} />
            <div><button type="submit" disabled={!s.achetable}>Acheter</button></div>
          </form>
        ))}
      </div>
      <p class="doux" style="font-size:.9rem">Paiement par carte sur Stripe, au nom de Trois-Tiers asbl. Une question « profonde » compte pour 3.</p>
    </section>
  )}

  {s.achats.length > 0 && (
    <section class="bloc">
      <h2>Vos achats</h2>
      <div class="defile">
        <table>
          <thead><tr><th>Date</th><th>Pack</th><th>Questions restantes</th><th>Montant</th></tr></thead>
          <tbody>
            {s.achats.map((a) => (
              <tr>
                <td>{dateCourte(a.purchased_at)}</td>
                <td>{s.packs.find((p) => p.code === a.pack_code)?.label ?? a.pack_code}</td>
                <td>{a.credits_remaining} sur {a.credits}</td>
                <td>{a.amount_cents != null && a.currency ? euros(a.amount_cents, a.currency) : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  <p><a href="/membre/bibliotheque">← Retour à la bibliothèque</a></p>
</Base>

<style>
  .soldes { display: flex; flex-wrap: wrap; gap: 12px 40px; border-block: 1px solid var(--trait); padding-block: 14px; }
  .soldes p { display: grid; gap: 2px; }
  .chiffre { font: 700 2rem/1 var(--titre); }
  .pack h3 { font-size: 1.3rem; }
  .prix { font: 700 1.6rem var(--titre); color: var(--accent); }
</style>
