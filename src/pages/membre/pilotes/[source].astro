---
import "@fontsource/fraunces/400.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/900.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/500.css";
import "@fontsource/public-sans/600.css";
import "@fontsource/public-sans/700.css";
import "@fontsource/public-sans/800.css";
import "../../../styles/pilote-artefact.css";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse } from "yaml";
import Base from "../../../layouts/Base.astro";
import { acteurConnecte, messageBase } from "../../../lib/acteur";
import {
  baseConfiguree, historiquePilote, importerPiloteMissions, SOURCE_PILOTE, tableauPilote,
  type BilanImport, type EntreeHistorique, type TableauPilote,
} from "../../../lib/base";

// Le Pilote 3/3 sur troistiers.space, avec le design et les onglets de l'artefact (Tableau, Missions, Planning,
// Salle d'attente, Agents & journal, recherche, fiches). Données : la copie synchronisée de la base Trois-Tiers,
// en lecture seule pendant la transition (on modifie dans l'artefact, puis « Synchroniser »). Réservé à l'équipe.
const u = Astro.locals.utilisateur;
const source = Astro.params.source ?? "";
const ici = `/membre/pilotes/${encodeURIComponent(source)}`;
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
if (!baseConfiguree() || !SOURCE_PILOTE.test(source)) return Astro.redirect("/membre/projets");
const acteur = await acteurConnecte(Astro.cookies);
if (!acteur) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);

// Synchroniser : dépôt de l'export JSON de l'artefact (coordination ; la base revérifie le droit).
let bilan: BilanImport | null = null;
let message = "";
const envoi = Astro.request.method === "POST";
if (envoi) {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  try {
    const f = await Astro.request.formData();
    const fichier = f.get("export");
    if (!(fichier instanceof File) || fichier.size === 0) message = "Choisissez le fichier JSON exporté depuis l'artefact.";
    else if (fichier.size > 15 * 1024 * 1024) message = "Fichier trop lourd (15 Mo au plus).";
    else {
      let donnees: unknown = null;
      try { donnees = JSON.parse(await fichier.text()); } catch { message = "Ce fichier n'est pas un JSON lisible."; }
      if (donnees && typeof donnees === "object" && Array.isArray((donnees as { tasks?: unknown }).tasks)) {
        const avecTitre = donnees as { titre?: string };
        avecTitre.titre ??= source === "pilote-33" ? "Pilote 3/3" : `Pilote ${source}`;
        bilan = await importerPiloteMissions(source, avecTitre, acteur);
      } else if (!message) message = "Ce fichier ne ressemble pas à l'export du Pilote (« Exporter tout (JSON) »).";
    }
  } catch (e) {
    console.error("Pilote (import) :", e);
    message = (e as { code?: string })?.code === "42501" ? "La synchronisation est réservée à la coordination." : messageBase(e, "La synchronisation n'a pas abouti.");
  }
}

let tableau: TableauPilote | null = null;
let historique: EntreeHistorique[] = [];
let erreur = "";
try {
  tableau = await tableauPilote(source, acteur);
  if (tableau) historique = await historiquePilote(tableau.racine.id, acteur, 1000);
} catch (e) {
  console.error("Pilote (tableau) :", e);
  erreur = "Le Pilote n'a pas pu être chargé. Réessayez dans un instant.";
}

// Première synchronisation : le Pilote n'existe pas encore dans la base ; la page propose le dépôt de l'export.
const premiereFois = !tableau && !erreur;

// Données au format de l'artefact (identifiants des tâches et des missions, codes des personnes et des chantiers).
let donnees = "{}";
if (tableau) {
  const codeChantier = new Map(tableau.chantiers.map((c) => [c.nom, c.code ?? c.nom]));
  const codeMission = new Map(tableau.missions.map((m) => [m.id, m.ref.split(":mission:")[1] ?? m.ref]));
  const codePersonne = new Map(tableau.personnes.filter((p) => p.id).map((p) => [p.id!, p.code]));
  const STATUT: Record<string, string> = { a_faire: "todo", en_cours: "doing", bloque: "block", fait: "done" };
  const membres = [...tableau.personnes].sort((a, b) => Number(a.code === "col") - Number(b.code === "col"))
    .map((p) => ({ k: p.code, n: p.nom }));
  const taches = tableau.taches.filter((t) => !t.absence).map((t) => {
    const codes = [...new Set([...t.responsables.map((r) => codePersonne.get(r.id)).filter(Boolean), ...t.responsables_alias])] as string[];
    return {
      id: t.ref ?? t.id, title: t.titre, status: STATUT[t.statut] ?? "todo",
      chantier: t.couloir ? codeChantier.get(t.couloir) ?? t.couloir : null,
      pilot: t.porteur ?? null, contributors: codes.filter((c) => c !== t.porteur),
      mission: t.mission ? codeMission.get(t.projet_id) ?? null : null,
      start: t.debut, end: t.echeance, milestone: t.jalon, deps: t.dependances ?? [], estimate_h: t.estimation_h ?? null,
      notes: t.notes ?? "", source: t.source ?? null, subtasks: t.sous_taches.map((s) => ({ t: s.texte, d: s.fait })),
      famille: t.famille ?? null, famille_choisie: !!t.famille_choisie,
    };
  });
  const absences = tableau.taches.filter((t) => t.absence).map((t) => ({
    id: t.ref ?? t.id, who: t.porteur ?? t.responsables_alias[0] ?? null, start: t.debut, end: t.echeance, label: t.titre,
  }));
  const missions = tableau.missions.map((m) => ({
    id: codeMission.get(m.id), name: m.titre, type: m.fiche.type ?? "autre", statut: m.fiche.statut ?? "active",
    lieu: m.fiche.lieu ?? m.territoire ?? "", referent: m.fiche.referent ?? null, aliases: m.fiche.alias ?? [],
    context_md: m.fiche.contexte ?? "", requests_md: m.fiche.demandes ?? "", next_actions: m.fiche.prochaines_actions ?? [],
    sources: m.fiche.sources ?? [], last_activity: m.fiche.derniere_activite ?? null,
    famille: m.famille ?? null, famille_choisie: !!m.famille_choisie,
  }));
  const journal = historique.filter((h) => h.genre === "journal").map((h) => ({
    id: h.ref, ts: h.quand, who: h.qui, type: h.type, summary: h.resume ?? "", task_id: h.tache, source: h.source ?? null,
  }));
  const propositions = historique.filter((h) => h.genre === "proposition").map((h) => ({
    id: h.ref, kind: h.type, status: h.statut ?? "accepted", author: h.qui, created_at: h.quand, reason: h.resume ?? "",
    task_id: h.tache, mission: codeMission.get(h.projet_id) ?? null, source: h.source ?? null,
  }));
  const conges = parse(readFileSync(resolve(process.cwd(), "data/conges.yaml"), "utf8"));
  const periodes = (z: string, l?: { nom: string; debut: string; fin: string }[]) =>
    (l ?? []).map((p) => ({ z, n: p.nom, s: String(p.debut).slice(0, 10), e: String(p.fin).slice(0, 10) }));
  donnees = JSON.stringify({
    racine: tableau.racine, peut_importer: tableau.peut_importer, peut_classer: !!tableau.peut_classer,
    familles: tableau.familles ?? [], url_classer: `${ici}/classer`, vue: envoi ? "journal" : null,
    import: envoi ? { bilan, message } : null,
    membres, chantiers: tableau.chantiers.map((c) => ({ k: c.code ?? c.nom, n: c.nom })),
    taches, absences, missions, journal, propositions,
    conges: [...periodes("be", conges?.belgique?.periodes), ...periodes("fr", conges?.france?.periodes)],
  }).replace(/</g, "\\u003c");
}
const titre = tableau?.racine.titre ?? (source === "pilote-33" ? "Pilote 3/3" : "Pilote");
---
<Base titre={titre}>
  <div class="p33">
    <div class="wrap" id="app">
      <div class="head">
        <div>
          <p class="eyebrow"><a href="/membre/projets">Projets</a> · Trois-Tiers · outil de pilotage partagé</p>
          <h1>{titre}</h1>
          <p class="sub">Le Gantt de l'équipe, tenu à jour par les agents du Pilote : PV, mails, Drive, grille des prestations, Element. Pendant la transition, on travaille dans l'artefact ; le site en garde une copie, en lecture, réservée à l'équipe.</p>
          <p class="status-line" id="statusline">{erreur || (premiereFois ? "Le Pilote n'est pas encore synchronisé." : "Chargement…")}</p>
        </div>
      </div>

      {tableau ? (
        <>
          <div class="toolbar">
            <div class="tabs" id="tabs" role="tablist"></div>
            <div class="search" role="search"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="m13 13 5 5" stroke-linecap="round"/></svg><input type="search" id="q" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="Rechercher : tâche, mission, note, décision, ID…" aria-label="Rechercher dans le Pilote" aria-controls="search-results" /><kbd>/</kbd></div>
          </div>
          <div id="search-results" hidden></div>
          <div class="filters" id="filters"></div>
          <div class="summary" id="summary"></div>
          <div id="view-tableau"></div>
          <div id="view-missions" hidden></div>
          <div id="view-planning" hidden></div>
          <div id="view-attente" hidden></div>
          <div id="view-journal" hidden></div>
          <div id="fiche"></div>
          <p class="foot">Copie synchronisée de l'artefact Pilote : missions, tâches, absences, journal et propositions des agents. Les modifications, validations et analyses de PV se font encore dans l'artefact ; « Synchroniser » (onglet Agents &amp; journal) met cette copie à jour.</p>
        </>
      ) : premiereFois && (
        <div class="section" style="margin-top:22px">
          <h2>Première synchronisation</h2>
          {message && <p class="pill warn" role="alert">{message}</p>}
          <p class="hint">Dans l'artefact Pilote, onglet « Agents &amp; journal », cliquez « Exporter tout (JSON) », puis déposez le fichier ici. Réservé à la coordination.</p>
          <form method="post" enctype="multipart/form-data" class="formrow" style="margin-top:8px">
            <div class="field wide"><label for="export">Export de l'artefact (.json)</label><input id="export" name="export" type="file" accept="application/json,.json" required /></div>
            <button class="btn primary" type="submit">Synchroniser</button>
          </form>
        </div>
      )}
    </div>
  </div>
  {tableau && <script type="application/json" id="p33-donnees" set:html={donnees} />}
</Base>

<style is:global>
  /* La page du Pilote occupe toute la largeur, comme l'artefact. */
  .enveloppe:has(> .p33) { max-width: none; padding-inline: 0; }
  main:has(> .p33) { padding-block: 0; }
  .p33 { min-height: 70vh; }
  .p33 .eyebrow a { color: inherit; }
  .p33 .famtag { font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--ink-soft); background: var(--panel-2); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px; }
  .p33 .mmeta label .fsel { max-width: 240px; }
  .p33 .stsel.ro { display: inline-block; cursor: default; text-align: center; width: auto; min-width: 84px; }
</style>

<script>
  if (document.getElementById("p33-donnees")) import("../../../scripts/pilote-missions");
</script>
