---
import Base from "../../../layouts/Base.astro";
import FaceCtgBloc from "../../../components/FaceCtg.astro";
import { acteurConnecte, messageBase } from "../../../lib/acteur";
import {
  baseConfiguree, enregistrerPublicationAuto, enregistrerQueteCtg, projetsAPublier, publicationCtg, quetesLiees, type FaceCtg,
} from "../../../lib/base";
import { empreinte, ErreurPublication, publicationAutoActive, publiableAuto, publierSurCtg } from "../../../lib/publication-ctg";
import { jetonsValides } from "../../../lib/ctg";
import { lireJetons } from "../../../lib/jetons";
import { quetesAdmin, quetesProches, type QueteCtgAdmin } from "../../../lib/quetes-ctg";
import { chargerContenu } from "../../../lib/contenu";

// Projets dont la publication sur ChangeTheGame est validée et dont la quête reste à créer (coordination).
// Pour chacun : la face publique à recopier dans CTG, puis l'adresse de la quête créée (qui pose ctg_quete_id).
const u = Astro.locals.utilisateur;
const ici = "/membre/quetes/a-publier";
if (!u) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);
if (!baseConfiguree()) return Astro.redirect("/membre/projets");
const acteur = await acteurConnecte(Astro.cookies);
if (!acteur) return Astro.redirect(`/connexion?suite=${encodeURIComponent(ici)}`);

let message = "";
if (Astro.request.method === "POST") {
  const origine = Astro.request.headers.get("origin");
  if (origine && origine !== Astro.url.origin) return new Response("Origine refusée", { status: 403 });
  const f = await Astro.request.formData();
  const projet = String(f.get("projet") ?? "");
  try {
    // Publication automatique (palier 2, B1) : la quête est créée au nom de la personne, puis reliée.
    if (f.get("action") === "auto" && publicationAutoActive() && /^[0-9a-f-]{36}$/i.test(projet)) {
      const jetons = await jetonsValides(lireJetons(Astro.cookies));
      if (!jetons) return Astro.redirect(`/auth/ctg?suite=${encodeURIComponent(ici)}`);
      const face = await publicationCtg(projet, acteur);
      if (!face || !publiableAuto(face) || !face.validee_le) throw new ErreurPublication(422, "Ce projet ne peut pas être publié automatiquement.");
      const quete = await publierSurCtg(jetons.acces, projet, face);
      await enregistrerPublicationAuto(acteur, projet, quete, empreinte(face));
      return Astro.redirect(`${ici}?fait=auto`, 303);
    }
    if (/^[0-9a-f-]{36}$/i.test(projet)) {
      await enregistrerQueteCtg(acteur, projet, String(f.get("adresse") ?? "").trim().slice(0, 500));
      return Astro.redirect(`${ici}?fait=1`, 303);
    }
  } catch (e) {
    message = e instanceof ErreurPublication
      ? (e.statut === 403 ? "ChangeTheGame ne vous reconnaît pas comme admin de la guilde." : e.statut === 503 ? "La publication automatique n'est pas encore ouverte côté ChangeTheGame." : `Publication refusée : ${e.message}`)
      : (e as { code?: string })?.code === "23514" ? `Refusé : ${(e as Error).message}` : messageBase(e);
  }
}
let liste: FaceCtg[] = [];
try {
  liste = await projetsAPublier(acteur);
} catch (e) {
  console.error("Quêtes à publier :", e);
  message ||= messageBase(e, "La liste n'a pas pu être chargée.");
}
const lienGuilde = chargerContenu().liens.changethegame_guilde;
const auto = publicationAutoActive();

// Rapprochement avant création (palier 2, B2) : quêtes de la guilde, pas encore reliées, qui ressemblent au projet.
// Lues avec le jeton CTG de la personne (admin de la guilde) ; si CTG ne répond pas, la page reste utilisable sans.
let proches = new Map<string, { quete: QueteCtgAdmin; score: number }[]>();
if (liste.length) {
  try {
    const jetons = await jetonsValides(lireJetons(Astro.cookies));
    const [quetes, liees] = jetons ? await Promise.all([quetesAdmin(jetons.acces), quetesLiees()]) : [null, []];
    if (quetes) {
      const prises = new Set(liees.map((l) => l.quete));
      const libres = quetes.filter((q) => !prises.has(q.id));
      proches = new Map(liste.map((f) => [f.id!, quetesProches(f, libres)]));
    }
  } catch (e) {
    console.error("Rapprochement des quêtes :", e);
  }
}
---
<Base titre="Quêtes à publier">
  <p class="surtitre"><a href="/membre">Espace membres</a> · <a href="/membre/projets">Projets</a> · Quêtes à publier</p>
  <section class="hero">
    <h1>Quêtes à publier</h1>
    <p class="lead">Les projets dont la publication sur ChangeTheGame est validée. Pour chacun, créez la quête dans la guilde Trois-Tiers en recopiant la face publique, puis collez ici son adresse.</p>
  </section>
  {Astro.url.searchParams.get("fait") && <p class="pastille" role="status">{Astro.url.searchParams.get("fait") === "auto"
    ? "Quête créée sur ChangeTheGame et reliée : elle suivra désormais le projet (résumé, nature, étape, besoins publics)."
    : "Lien enregistré : le projet est relié à sa quête."}</p>}
  {message && <p class="avertissement" role="alert">{message}</p>}
  {liste.length === 0 ? (
    <p class="doux">Rien à publier pour l'instant. Les référents proposent une publication depuis la fiche de leur projet ; vous la validez dans la <a href="/membre/revue">file de revue</a>.</p>
  ) : (
    <div class="a-publier">
      {liste.map((f) => (
        <section class="panneau">
          <h2><a href={`/membre/projets/${f.id}`}>{f.titre}</a></h2>
          {(proches.get(f.id!) ?? []).length > 0 && (
            <div class="proches">
              <p><strong>Avant de créer :</strong> cette quête existe peut-être déjà dans la guilde. Reliez-la plutôt que d'en créer une seconde.</p>
              <ul>
                {proches.get(f.id!)!.map(({ quete }) => (
                  <li>
                    <a href={quete.url} rel="noopener">{quete.title}</a>{quete.is_draft && <span class="doux"> (brouillon)</span>}
                    <form method="post" action={ici}>
                      <input type="hidden" name="projet" value={f.id} />
                      <input type="hidden" name="adresse" value={quete.url} />
                      <button class="bouton creux">Relier à cette quête</button>
                    </form>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {auto && publiableAuto(f) && (
            <form method="post" action={ici} class="auto">
              <input type="hidden" name="action" value="auto" />
              <input type="hidden" name="projet" value={f.id} />
              <button class="bouton">Publier automatiquement sur ChangeTheGame</button>
              <span class="doux">La quête est créée à votre nom dans la guilde, puis tenue à jour par le site.</span>
            </form>
          )}
          <FaceCtgBloc face={f} projet={f.id!} action={ici} lienGuilde={lienGuilde} />
        </section>
      ))}
    </div>
  )}
</Base>

<style>
  .a-publier { display: grid; gap: 16px; }
  .a-publier h2 { font-size: 1.15rem; margin: 0 0 8px; }
  .proches { border-left: 3px solid var(--accent, #2f6b47); padding: 4px 0 4px 12px; margin: 0 0 14px; }
  .proches ul { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 8px; }
  .proches li { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
  .proches form { margin: 0; }
  .auto { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin: 0 0 12px; }
</style>
