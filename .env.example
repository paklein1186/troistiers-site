# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.

# --- Session ---------------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères, qui signe le cookie de session.
SESSION_SECRET=

# Mode démonstration : permet de « se connecter » en choisissant un profil,
# sans ChangeTheGame. À désactiver (false) dès que la connexion CTG marche.
MODE_DEMO=true

# --- Connexion unique via ChangeTheGame (OAuth 2.1 / OpenID Connect) ------
# Émetteur Supabase de ChangeTheGame, ex. https://<projet>.supabase.co/auth/v1
CTG_ISSUER=
# Identifiants de l'application cliente « troistiers.space » enregistrée dans CTG.
CTG_CLIENT_ID=
CTG_CLIENT_SECRET=
# Adresse de retour déclarée dans CTG.
CTG_REDIRECT_URI=http://localhost:4321/auth/callback
# Nom des informations ajoutées au jeton par CTG (à créer côté CTG).
CTG_CLAIM_PROFIL=trois_tiers_profil
CTG_CLAIM_BADGES=trois_tiers_badges

# --- Space2 (lieux à soutenir, carte, observatoire) -----------------------
SPACE2_API_URL=
# Secret partagé de l'API Space2 (en-tête X-Webhook-Secret). Côté serveur uniquement.
SPACE2_API_SECRET=

# --- Stripe (compte de Trois-Tiers, mode test) -----------------------------
# Clé publiable : peut être exposée au navigateur.
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clé secrète : JAMAIS dans le dépôt ni dans une conversation.
STRIPE_SECRET_KEY=
