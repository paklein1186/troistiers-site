# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.

# --- Session ---------------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères, qui signe le cookie de session.
SESSION_SECRET=

# Mode démonstration : permet de « se connecter » en choisissant un profil,
# sans ChangeTheGame. À désactiver (false) dès que la connexion CTG marche.
MODE_DEMO=true

# Adresse publique du site (sans / final), utilisée pour le retour après paiement.
# Vide = l'adresse de la requête (convient en local). En ligne : https://troistiers.space
SITE_URL=

# --- Connexion unique via ChangeTheGame (OAuth 2.1 de Supabase) ----------
# Émetteur Supabase de ChangeTheGame (production) :
CTG_ISSUER=https://anzeimppqytonfxrnqxp.supabase.co/auth/v1
# Fonctions de CTG (par défaut : <origine de l'émetteur>/functions/v1).
CTG_FUNCTIONS_URL=
# Identifiant de la guilde Trois-Tiers sur ChangeTheGame.
CTG_GUILD_ID=
# Adresse de retour après connexion (à changer en production).
CTG_REDIRECT_URI=http://localhost:4321/auth/callback
# Facultatif : sans identifiant, le site s'enregistre lui-même auprès de CTG au
# premier usage et garde le résultat dans .ctg-client.json (jamais versionné).
CTG_CLIENT_ID=
CTG_CLIENT_SECRET=

# --- Space2 (lieux à soutenir, carte, observatoire) -----------------------
SPACE2_API_URL=
# Clé de LECTURE SEULE du site, posée côté Space2 sous SITE_READ_SECRET (tableau de bord Render).
# N'ouvre que GET /lieux. Ne jamais utiliser ici le secret de ChangeTheGame (CTG_WEBHOOK_SECRET),
# qui ouvre aussi l'écriture. Côté serveur uniquement. Exemple d'adresse : https://<service>.onrender.com
SPACE2_API_SECRET=

# --- Stripe (compte de Trois-Tiers, mode test) -----------------------------
# Clé publiable : peut être exposée au navigateur.
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clé secrète : JAMAIS dans le dépôt ni dans une conversation.
STRIPE_SECRET_KEY=

# Base Trois-Tiers (Supabase dédiée, au nom de l'ASBL, région UE ; lot 1 du brief) — voir docs/base-trois-tiers.md.
# Le site y recopie le badge de statut de chaque personne à la connexion. Sans ces deux valeurs, rien ne se passe.
# TT_BASE_SERVICE_KEY : clé service_role de CE projet (jamais celle de ChangeTheGame), uniquement ici, jamais dans le dépôt.
TT_BASE_URL=
TT_BASE_SERVICE_KEY=
