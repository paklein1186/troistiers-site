# Bac à sable du site Trois-Tiers (étape 2 de la décision D du 27/11). Copier en .env.bac-a-sable (jamais versionné),
# remplir, puis : npm run dev:bac-a-sable  →  http://localhost:4322
# Seul ce fichier est lu : le .env du site réel est ignoré. Base d'essai seulement (la production est refusée).
BAC_A_SABLE=true
SESSION_SECRET=une-longue-phrase-differente-de-celle-du-site-reel
MODE_DEMO=false

# Base d'essai « tt-bac-a-sable » (Supabase : Project Settings → API). Jamais la base Trois-Tiers de production.
TT_BASE_URL=https://<ref-du-bac-a-sable>.supabase.co
TT_BASE_SERVICE_KEY=

# Connexion avec ChangeTheGame (votre propre compte) : CTG_ISSUER et CTG_FUNCTIONS_URL = mêmes valeurs que dans .env.
CTG_ISSUER=
CTG_GUILD_ID=4964c699-4684-43a9-b508-cee21c77e24e
CTG_FUNCTIONS_URL=
# Propres au bac à sable (ne pas recopier celles du .env) : son adresse de retour et son enregistrement chez CTG.
CTG_REDIRECT_URI=http://localhost:4322/auth/callback
CTG_CLIENT_FILE=.ctg-client-bac-a-sable.json

# Coupés d'office dans le bac à sable, même s'ils sont remplis : PILOTE_33_EXPORT, CTG_PUBLICATION_AUTO, CTG_SITE_SYNC_KEY.
# Space2 (bibliothèque, entretien) : laisser vide, il écrit dans des données réelles.

# Fichiers locaux du site (quotas de la bibliothèque) : séparés de ceux du site réel.
DONNEES_DIR=.donnees-bac-a-sable
