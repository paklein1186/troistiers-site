{
  "name": "troistiers-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site Trois-Tiers : partie publique, espace membre et administration, connexion via ChangeTheGame",
  "scripts": {
    "dev": "astro dev",
    "dev:bac-a-sable": "node --env-file=.env.bac-a-sable node_modules/astro/astro.js dev --port 4322",
