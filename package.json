    "@fontsource/public-sans": "^5.1.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@types/leaflet": "1.9.12",
    "astro": "4.16.18",
    "leaflet": "1.9.4",
    "marked": "15.0.12",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "22.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
